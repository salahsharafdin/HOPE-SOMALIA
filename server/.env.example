# ========================================================
# Hope Somalia Foundation - Backend Environment Variables
# ========================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Database Connection
# Production (Render/Neon/Supabase PostgreSQL):
# DATABASE_URL="postgresql://username:password@hostname:5432/databasename?sslmode=require"
# Local SQLite (if testing with schema.sqlite.prisma):
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://hope_somalia_user:your_secure_password@hope-somalia-db:5432/hope_somalia"

# Authentication
# Generate a strong random 64-character secret for production
JWT_SECRET="your_strong_random_jwt_secret_here_replace_in_production"

# Allowed Client Origin (Frontend on Vercel)
# Comma-separated list of allowed URLs
CLIENT_URL="https://your-app-name.vercel.app,http://localhost:5173"

# Email Delivery (Gmail SMTP for 2FA OTP & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Hope Somalia Foundation <your-email@gmail.com>"
