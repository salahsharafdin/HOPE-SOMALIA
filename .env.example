# ========================================================
# Hope Somalia Foundation - Environment Configuration Template
# ========================================================

# --------------------------------------------------------
# 1. BACKEND / SERVER ENVIRONMENT VARIABLES
# (Set these on Render / Railway dashboard)
# --------------------------------------------------------
PORT=5000
NODE_ENV=production
DATABASE_URL="postgresql://hope_somalia_user:your_secure_password@hope-somalia-db:5432/hope_somalia"
JWT_SECRET="your_strong_random_jwt_secret_here_replace_in_production"
CLIENT_URL="https://your-app-name.vercel.app,http://localhost:5173"

# Transactional Email (Gmail SMTP for 2FA OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Hope Somalia Foundation <your-email@gmail.com>"

# --------------------------------------------------------
# 2. FRONTEND / CLIENT ENVIRONMENT VARIABLES
# (Set these on Vercel Project Settings > Environment Variables)
# --------------------------------------------------------
VITE_API_URL="https://your-backend-api.onrender.com/api"
